{
  "name": "detent",
  "version": "0.2.0",
  "description": "Skills and small tools for software development with AI coding agents",
  "license": "MIT",
  "type": "module",
  "bin": {
    "detent": "dist/cli.js"
  },
  "files": [
    "dist",
    "prompts",
    "skills",
    "constitution"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build",
    "gate": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
