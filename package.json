{
  "name": "@ysilvestrov/detent",
  "version": "0.5.0",
  "description": "Skills and small tools for software development with AI coding agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ysilvestrov/detent.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "detent": "dist/cli.js"
  },
  "exports": {
    "./pr-review": "./dist/pr-review/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "prompts",
    "skills",
    "constitution"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build",
    "gate": "npm run typecheck && npm test && npm run build",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
